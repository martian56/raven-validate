// raven-validate: collect validation errors over a set of fields.
//
//     from "github.com/martian56/raven-validate" import Validator
//
//     let v = Validator.new()
//     v.required("name", name)
//     v.min_len("name", name, 2)
//     v.email("email", email)
//     if v.is_valid() { save() } else { print(v.errors()) }
//
// Each rule adds a message when it fails. The validator keeps going so you can
// show every problem at once instead of one at a time. The rule methods also
// return the validator, so you can chain them if you prefer.

import std.string

class Validator {
    errors: list[str]
}

impl Validator {
    fun new() -> Validator {
        let e: list[str] = []
        return Validator(errors: e)
    }

    // A free-form check: records `message` when `ok` is false.
    fun check(self, ok: bool, message: str) -> Validator {
        if not ok {
            self.errors.push(message)
        }
        return self
    }

    // `value` must not be empty.
    fun required(self, field: str, value: str) -> Validator {
        return self.check(value != "", "${field} is required")
    }

    // `value` must be at least `n` characters.
    fun min_len(self, field: str, value: str, n: int) -> Validator {
        return self.check(
            value.length() >= n,
            "${field} must be at least ${n.to_string()} characters",
        )
    }

    // `value` must be at most `n` characters.
    fun max_len(self, field: str, value: str, n: int) -> Validator {
        return self.check(
            value.length() <= n,
            "${field} must be at most ${n.to_string()} characters",
        )
    }

    // `value` must look like an email address (a basic shape check).
    fun email(self, field: str, value: str) -> Validator {
        let at = value.index_of("@")
        let dot = value.index_of(".")
        let ok = at > 0 and dot > at and not value.ends_with(".")
        return self.check(ok, "${field} is not a valid email")
    }

    // `value` must be one of `options`.
    fun one_of(self, field: str, value: str, options: list[str]) -> Validator {
        var i = 0
        var found = false
        while i < options.len() {
            if options[i] == value {
                found = true
            }
            i += 1
        }
        return self.check(found, "${field} is not an allowed value")
    }

    // An integer `value` must be between `lo` and `hi` inclusive.
    fun in_range(self, field: str, value: int, lo: int, hi: int) -> Validator {
        let ok = value >= lo and value <= hi
        return self.check(ok, "${field} must be between ${lo.to_string()} and ${hi.to_string()}")
    }

    fun is_valid(self) -> bool {
        return self.errors.len() == 0
    }

    fun errors(self) -> list[str] {
        return self.errors
    }

    // The first error, or `None` when everything passed.
    fun first_error(self) -> Option[str] {
        if self.errors.len() == 0 {
            return None
        }
        return Some(self.errors[0])
    }
}
